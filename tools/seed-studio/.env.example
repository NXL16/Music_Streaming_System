# Seed Studio only binds to 127.0.0.1. Keep this URL pointed at the local API
# unless it is connected through an authenticated private network.
BASE_URL=http://localhost:9999/v1
PORT=4311

# Must exactly match FINALIZER_INTERNAL_TOKEN in apps/api/.env.
# Do not put an admin JWT or any public-facing token here.
FINALIZER_INTERNAL_TOKEN=
SEED_ARTIST_PASSWORD=

# Optional absolute path to chrome.exe. Seed Studio otherwise uses Chrome in
# Program Files and retains the Apple Music session only in .tmp.
APPLE_MUSIC_CHROME_PATH=

# Optional bounded wait for the real transcode/completion queue.
SEED_READY_WAIT_TIMEOUT_MS=1200000
SEED_READY_WAIT_POLL_MS=3000
SEED_ASSET_READY_WAIT_TIMEOUT_MS=1800000
SEED_ASSET_READY_WAIT_POLL_MS=3000
# Maximum time allowed for a browser-to-Seed-Studio media transfer.
SEED_MEDIA_TRANSFER_TIMEOUT_MS=3600000
SEED_API_REQUEST_TIMEOUT_MS=30000
