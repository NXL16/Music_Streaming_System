{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "404Hz Lyrics Studio",
	"version": "0.1.0",
	"identifier": "me.404hz.lyrics-studio",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm build"
	},
	"app": {
		"windows": [
			{
				"title": "",
				"label": "main",
				"width": 800,
				"height": 600,
				"resizable": true,
				"devtools": true,
				"fullscreen": false,
				"dragDropEnabled": false,
				"visible": false
			}
		],
		"security": {
			"csp": null,
			"headers": {
				"Cross-Origin-Opener-Policy": "same-origin",
				"Cross-Origin-Embedder-Policy": "require-corp"
			}
		}
	},
	"bundle": {
		"category": "Utility",
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
