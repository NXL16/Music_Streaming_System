generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CatalogDraftStatus {
  DRAFT
  PUBLISHED
  SUBMITTED
  CHANGES_REQUESTED
}

enum SongLyricStatus {
  DRAFT
  PUBLISHED
}

enum SongLyricSyncMode {
  LINE
  WORD
}

enum SongLyricLineKind {
  LYRIC
  INSTRUMENTAL
}

enum SongAudioMode {
  STANDARD
  SING
}

enum AudioAnalysisStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum ArtistMemberRole {
  OWNER
  MANAGER
  EDITOR
  PRODUCTION
  ANALYST
}

model CatalogDraft {
  id           String             @id @default(uuid())
  resourceType String             @db.VarChar(32)
  resourceId   String             @db.VarChar(128)
  storefront   String             @default("vn") @db.VarChar(8)
  status       CatalogDraftStatus @default(DRAFT)
  payload      Json
  version      Int                @default(1)
  createdBy    String             @db.VarChar(128)
  updatedBy    String             @db.VarChar(128)
  publishedAt  DateTime?          @db.Timestamptz
  submittedAt  DateTime?          @db.Timestamptz
  reviewedAt   DateTime?          @db.Timestamptz
  reviewedBy   String?            @db.VarChar(128)
  reviewNote   String             @default("") @db.VarChar(2000)
  createdAt    DateTime           @default(now()) @db.Timestamptz
  updatedAt    DateTime           @updatedAt @db.Timestamptz

  @@unique([resourceType, resourceId, storefront])
  @@index([status, resourceType, storefront, updatedAt])
  @@map("catalog_drafts")
}

model CatalogAssetUsageOutbox {
  id           String    @id @default(uuid())
  resourceType String    @db.VarChar(32)
  resourceId   String    @db.VarChar(128)
  storefront   String    @db.VarChar(8)
  usages       Json
  attempts     Int       @default(0)
  availableAt  DateTime  @default(now()) @db.Timestamptz
  lockedAt     DateTime? @db.Timestamptz
  lastError    String    @default("") @db.VarChar(2000)
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz

  @@unique([resourceType, resourceId, storefront])
  @@index([availableAt, lockedAt])
  @@map("catalog_asset_usage_outbox")
}

model PreferenceOutbox {
  id           String   @id @default(uuid())
  eventId      String   @unique @db.VarChar(128)
  userId       String   @db.VarChar(128)
  eventType    Int
  resourceType String   @db.VarChar(64)
  resourceId   String   @db.VarChar(128)
  weight       Float
  attempts     Int      @default(0)
  availableAt  DateTime @default(now()) @db.Timestamptz
  lockedAt     DateTime? @db.Timestamptz
  lockedBy     String   @default("") @db.VarChar(128)
  deadLetteredAt DateTime? @db.Timestamptz
  lastError    String   @default("") @db.VarChar(2000)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  @@index([availableAt, lockedAt, deadLetteredAt])
  @@map("preference_outbox")
}

model Song {
  id                        String              @id @default(uuid())
  status                    Int                 @default(1)
  sourceObjectPath          String              @default("") @db.VarChar(500)
  audioMode                 SongAudioMode       @default(STANDARD)
  // Monotonic per-song generation assigned whenever processing is requested.
  // It fences late worker completions and metadata writes from an older source.
  transcodeVersion          BigInt              @default(0)
  checksum                  String?             @unique @db.VarChar(64)
  fileSizeBytes             BigInt              @default(0)
  encryptedFilePath         String              @default("") @db.VarChar(500)
  durationSec               Int                 @default(0)
  bitrateKbps               Int                 @default(0)
  codec                     String              @default("") @db.VarChar(32)
  format                    String              @default("fmp4") @db.VarChar(32)
  isCatalog                 Boolean             @default(false)
  storefront                String              @default("vn") @db.VarChar(8)
  catalogTitle              String              @default("") @db.VarChar(255)
  albumName                 String              @default("") @db.VarChar(255)
  artistName                String              @default("") @db.VarChar(500)
  extendedAssetUrls         Json?
  offers                    Json?
  audioLocale               String              @default("") @db.VarChar(32)
  audioTraits               String[]            @default([])
  moodTags                  String[]            @default([])
  moodAnalysisVersion       String              @default("") @db.VarChar(128)
  moodAnalysisScores        Json?
  moodAnalyzedAt            DateTime?           @db.Timestamptz
  audioAnalysisStatus       AudioAnalysisStatus @default(PENDING)
  audioAnalysisVersion      String              @default("") @db.VarChar(128)
  audioBpm                  Float?
  audioEnergy               Float?
  audioTags                 String[]            @default([])
  audioEmbedding            Float[]             @default([])
  audioAnalysisError        String              @default("") @db.VarChar(2000)
  audioAnalyzedAt           DateTime?           @db.Timestamptz
  composerName              String              @default("") @db.VarChar(1000)
  discNumber                Int                 @default(1)
  durationInMillis          Int                 @default(0)
  genreNames                String[]            @default([])
  hasLyrics                 Boolean             @default(false)
  hasTimeSyncedLyrics       Boolean             @default(false)
  isHighResolutionMaster    Boolean             @default(false)
  isStudioMastered          Boolean             @default(false)
  isVocalAttenuationAllowed Boolean             @default(false)
  isrc                      String?             @db.VarChar(32)
  previewUrl                String              @default("") @db.VarChar(1000)
  releaseDate               DateTime?           @db.Date
  trackNumber               Int                 @default(0)
  catalogUrl                String              @default("") @db.VarChar(1000)
  contentRating             String              @default("") @db.VarChar(32)
  createdAt                 DateTime            @default(now()) @db.Timestamptz
  updatedAt                 DateTime            @updatedAt @db.Timestamptz
  owners                    SongOwner[]
  albumTracks               AlbumTrack[]
  playlistTracks            PlaylistTrack[]
  artistCredits             SongArtistCredit[]
  contributorCredits        SongContributorCredit[]
  favorites                 Favorite[]
  userPlaylistTracks        UserPlaylistTrack[]
  lyric                     SongLyric?
  lyricDraft                SongLyricDraft?
  videos                    SongVideo[]

  @@index([status, createdAt])
  @@index([isCatalog, storefront])
  @@index([storefront, isCatalog, releaseDate(sort: Desc), id(sort: Desc)])
  @@index([catalogTitle])
  @@index([isrc])
  @@index([moodAnalyzedAt])
  @@index([audioAnalysisStatus, audioAnalyzedAt])
  @@index([audioTags], type: Gin)
  @@index([moodTags], type: Gin)
  @@map("songs")
}

enum SongVideoKind {
  OFFICIAL
  LYRIC
  LIVE
}

// A SongVideo is an additional visual rendition of a Song. All editorial
// metadata belongs to Song; this table stores only video-specific state.
model SongVideo {
  id           String        @id @default(uuid()) @db.Uuid
  songId       String        @db.VarChar(128)
  videoAssetId String        @unique @db.VarChar(128)
  kind         SongVideoKind @default(OFFICIAL)
  publishedAt  DateTime      @default(now()) @db.Timestamptz
  createdAt    DateTime      @default(now()) @db.Timestamptz
  updatedAt    DateTime      @updatedAt @db.Timestamptz

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([songId, kind])
  @@index([songId, publishedAt(sort: Desc)])
  @@map("song_videos")
}

model SongLyric {
  id        String            @id @default(uuid())
  songId    String            @unique @db.VarChar(128)
  language  String            @default("vi") @db.VarChar(16)
  sourceLrc String            @db.Text
  plainText String            @db.Text
  status    SongLyricStatus   @default(DRAFT)
  syncMode  SongLyricSyncMode @default(LINE)
  createdAt DateTime          @default(now()) @db.Timestamptz
  updatedAt DateTime          @updatedAt @db.Timestamptz

  song  Song            @relation(fields: [songId], references: [id], onDelete: Cascade)
  lines SongLyricLine[]

  @@index([status])
  @@map("song_lyrics")
}

model SongLyricDraft {
  id        String            @id @default(uuid())
  songId    String            @unique @db.VarChar(128)
  language  String            @default("vi") @db.VarChar(16)
  sourceLrc String            @db.Text
  plainText String            @db.Text
  syncMode  SongLyricSyncMode @default(LINE)
  lines     Json              @db.JsonB
  createdAt DateTime          @default(now()) @db.Timestamptz
  updatedAt DateTime          @updatedAt @db.Timestamptz

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@map("song_lyric_drafts")
}

model SongLyricLine {
  id          String            @id @default(uuid())
  lyricId     String
  position    Int
  startTimeMs Int
  endTimeMs   Int
  text        String            @db.Text
  kind        SongLyricLineKind @default(LYRIC)

  lyric SongLyric       @relation(fields: [lyricId], references: [id], onDelete: Cascade)
  words SongLyricWord[]

  @@unique([lyricId, position])
  @@index([lyricId, startTimeMs])
  @@map("song_lyric_lines")
}

model SongLyricWord {
  id          String @id @default(uuid())
  lineId      String
  position    Int
  startTimeMs Int
  endTimeMs   Int
  text        String @db.VarChar(500)

  line SongLyricLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@unique([lineId, position])
  @@index([lineId, startTimeMs])
  @@map("song_lyric_words")
}

model Artist {
  id                    String              @id @db.VarChar(128)
  storefront            String              @default("vn") @db.VarChar(8)
  name                  String              @db.VarChar(255)
  url                   String              @default("") @db.VarChar(1000)
  artworkAssetId        String              @default("") @db.VarChar(128)
  artwork               Json?
  editorialVideoAssetId String              @default("") @db.VarChar(128)
  editorialVideo        Json?
  genreNames            String[]            @default([])
  origin                String?             @db.VarChar(255)
  birthDate             DateTime?           @db.Date
  biography             String?             @db.Text
  biographySourceUrl    String?             @db.VarChar(2048)
  createdAt             DateTime            @default(now()) @db.Timestamptz
  updatedAt             DateTime            @updatedAt @db.Timestamptz
  songCredits           SongArtistCredit[]
  albumCredits          AlbumArtistCredit[]
  memberships           ArtistMembership[]

  @@index([storefront, name])
  @@index([artworkAssetId])
  @@index([editorialVideoAssetId])
  @@map("artists")
}

// Identity is owned by the Identity service, so userId intentionally remains
// a scalar here rather than a cross-database relation. This is the ownership
// boundary for every Artist workspace in Catalog.
model ArtistMembership {
  id        String           @id @default(uuid())
  artistId  String           @db.VarChar(128)
  userId    String           @db.VarChar(128)
  role      ArtistMemberRole
  createdBy String           @db.VarChar(128)
  createdAt DateTime         @default(now()) @db.Timestamptz
  updatedAt DateTime         @updatedAt @db.Timestamptz

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, userId])
  @@index([userId, updatedAt])
  @@index([artistId, role])
  @@map("artist_memberships")
}

model Album {
  id                      String    @id @db.VarChar(128)
  storefront              String    @default("vn") @db.VarChar(8)
  name                    String    @db.VarChar(255)
  artistName              String    @default("") @db.VarChar(500)
  artworkAssetId          String    @default("") @db.VarChar(128)
  editorialArtworkAssetId String    @default("") @db.VarChar(128)
  editorialVideoAssetId   String    @default("") @db.VarChar(128)
  artwork                 Json?
  editorialArtwork        Json?
  editorialNotes          Json?
  editorialVideo          Json?
  offers                  Json?
  audioTraits             String[]  @default([])
  contentRating           String    @default("") @db.VarChar(32)
  copyright               String    @default("") @db.VarChar(1000)
  genreNames              String[]  @default([])
  isCompilation           Boolean   @default(false)
  isComplete              Boolean   @default(true)
  isStudioMastered        Boolean   @default(false)
  isPrerelease            Boolean   @default(false)
  releaseType             String    @default("album") @db.VarChar(16)
  recordLabel             String    @default("") @db.VarChar(255)
  releaseDate             DateTime? @db.Date
  trackCount              Int       @default(0)
  upc                     String    @default("") @db.VarChar(64)
  ingestionSource         String?   @db.VarChar(32)
  ingestionKey            String?   @db.VarChar(128)
  canonicalReleaseId      String?   @db.VarChar(128)
  url                     String    @default("") @db.VarChar(1000)
  createdAt               DateTime  @default(now()) @db.Timestamptz
  updatedAt               DateTime  @updatedAt @db.Timestamptz

  tracks        AlbumTrack[]
  artistCredits AlbumArtistCredit[]
  sourceFavorites Favorite[] @relation("FavoriteSourceAlbum")
  favorites       AlbumFavorite[]
  sourcePlaylistTracks UserPlaylistTrack[] @relation("UserPlaylistTrackSourceAlbum")
  sourceLibraryResources UserLibraryResource[] @relation("LibraryResourceSourceAlbum")

  @@unique([ingestionSource, ingestionKey])
  @@index([storefront, name])
  @@index([releaseDate])
  @@index([artworkAssetId])
  @@index([editorialArtworkAssetId])
  @@index([editorialVideoAssetId])
  @@index([canonicalReleaseId])
  @@map("albums")
}

model AlbumTrack {
  id         String   @id @default(uuid()) @db.Uuid
  albumId    String
  songId     String
  position   Int
  discNumber Int      @default(1)
  popularity Float?
  createdAt  DateTime @default(now()) @db.Timestamptz

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  song  Song  @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([albumId, songId])
  @@unique([albumId, position])
  @@index([songId])
  @@map("album_tracks")
}

model AlbumArtistCredit {
  albumId   String
  artistId  String
  isPrimary Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz

  album  Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([albumId, artistId])
  @@unique([albumId, position])
  @@index([artistId])
  @@index([artistId, isPrimary])
  @@map("album_artist_credits")
}

model SongArtistCredit {
  songId    String
  artistId  String
  role      String   @default("artist") @db.VarChar(32)
  isPrimary Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz

  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([songId, artistId, role])
  @@unique([songId, role, position])
  @@index([artistId])
  @@index([artistId, songId])
  @@index([artistId, role, isPrimary])
  @@map("song_artist_credits")
}

// A credited person is not automatically a catalog Artist. This table keeps
// manual performance, writing, production, and engineering credits without
// creating a public artist profile or affecting artist discovery.
model SongContributorCredit {
  songId    String
  name      String   @db.VarChar(255)
  role      String   @db.VarChar(32)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([songId, role, position])
  @@index([songId])
  @@map("song_contributor_credits")
}

model Playlist {
  id                      String    @id @db.VarChar(128)
  storefront              String    @default("vn") @db.VarChar(8)
  name                    String    @db.VarChar(255)
  curatorName             String    @default("") @db.VarChar(255)
  descriptionShort        String    @default("") @db.VarChar(1000)
  descriptionStandard     String    @default("") @db.Text
  artworkAssetId          String    @default("") @db.VarChar(128)
  editorialArtworkAssetId String    @default("") @db.VarChar(128)
  editorialVideoAssetId   String    @default("") @db.VarChar(128)
  artwork                 Json?
  editorialArtwork        Json?
  editorialNotes          Json?
  editorialVideo          Json?
  plainEditorialCard      Json?
  plainEditorialNotes     Json?
  artistNames             String[]  @default([])
  audioTraits             String[]  @default([])
  editorialPlaylistKind   String    @default("") @db.VarChar(64)
  hasCollaboration        Boolean   @default(false)
  isChart                 Boolean   @default(false)
  playlistType            String    @default("editorial") @db.VarChar(32)
  supportsSing            Boolean   @default(false)
  versionHash             String    @default("") @db.VarChar(128)
  lastModifiedAt          DateTime? @db.Timestamptz
  url                     String    @default("") @db.VarChar(1000)
  ownerId                 String    @default("") @db.VarChar(128)
  isPublic                Boolean   @default(true)
  createdAt               DateTime  @default(now()) @db.Timestamptz
  updatedAt               DateTime  @updatedAt @db.Timestamptz

  tracks PlaylistTrack[]
  favorites PlaylistFavorite[]

  @@index([storefront, name])
  @@index([ownerId])
  @@index([artworkAssetId])
  @@index([editorialArtworkAssetId])
  @@index([editorialVideoAssetId])
  @@map("playlists")
}

model PlaylistTrack {
  playlistId String
  songId     String
  position   Int
  addedAt    DateTime @default(now()) @db.Timestamptz

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([playlistId, songId])
  @@unique([playlistId, position])
  @@index([songId])
  @@map("playlist_tracks")
}

model SongOwner {
  id        String   @id @default(uuid())
  songId    String   @db.VarChar(128)
  userId    String   @db.VarChar(128)
  isPublic  Boolean  @default(true)
  title     String   @default("") @db.VarChar(255)
  artist    String   @default("") @db.VarChar(255)
  album     String   @default("") @db.VarChar(255)
  tags      String[] @default([])
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([songId, userId])
  @@index([userId])
  @@index([userId, isPublic])
  @@map("song_owners")
}

model AssetCleanupOutbox {
  id                String    @id @default(uuid())
  songId            String    @unique @db.VarChar(128)
  sourceObjectPath  String    @default("") @db.VarChar(500)
  encryptedFilePath String    @default("") @db.VarChar(500)
  attempts          Int       @default(0)
  availableAt       DateTime  @default(now()) @db.Timestamptz
  lockedAt          DateTime? @db.Timestamptz
  lockedBy          String?   @db.VarChar(64)
  lastError         String    @default("") @db.VarChar(1000)
  createdAt         DateTime  @default(now()) @db.Timestamptz
  updatedAt         DateTime  @updatedAt @db.Timestamptz

  @@index([createdAt])
  @@index([availableAt, lockedAt])
  @@map("asset_cleanup_outbox")
}

model TranscodeOutbox {
  id               String        @id @default(uuid())
  songId           String        @unique @db.VarChar(128)
  sourceObjectPath String        @db.VarChar(500)
  checksum         String        @default("") @db.VarChar(64)
  audioMode        SongAudioMode @default(STANDARD)
  metadataVersion  BigInt        @default(0)
  attempts         Int           @default(0)
  availableAt      DateTime      @default(now()) @db.Timestamptz
  lockedAt         DateTime?     @db.Timestamptz
  lockedBy         String?       @db.VarChar(64)
  lastError        String        @default("") @db.VarChar(2000)
  createdAt        DateTime      @default(now()) @db.Timestamptz
  updatedAt        DateTime      @updatedAt @db.Timestamptz

  @@index([availableAt, lockedAt])
  @@map("transcode_outbox")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @db.VarChar(128)
  songId    String   @db.VarChar(128)
  sourceAlbumId String? @db.VarChar(128)
  createdAt DateTime @default(now()) @db.Timestamptz

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  sourceAlbum Album? @relation("FavoriteSourceAlbum", fields: [sourceAlbumId], references: [id], onDelete: SetNull)

  @@unique([userId, songId])
  @@index([userId, createdAt])
  @@index([songId])
  @@index([sourceAlbumId])
  @@map("favorites")
}

// Album favourites are deliberately separate from Library resources: removing
// the star must never remove the album or its tracks from a user's Library.
model AlbumFavorite {
  id        String   @id @default(uuid())
  userId    String   @db.VarChar(128)
  albumId   String   @db.VarChar(128)
  createdAt DateTime @default(now()) @db.Timestamptz

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([userId, albumId])
  @@index([userId, createdAt])
  @@index([albumId])
  @@map("album_favorites")
}

model SystemFavoriteArtwork {
  key       String   @id @db.VarChar(64)
  assetId   String   @unique @db.VarChar(128)
  artwork   Json
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("system_favorite_artworks")
}

model UserPlaylist {
  id          String   @id @default(uuid())
  userId      String   @db.VarChar(128)
  name        String   @db.VarChar(255)
  description String   @default("") @db.VarChar(1000)
  coverUrl    String   @default("") @db.VarChar(500)
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  tracks UserPlaylistTrack[]
  favorites UserPlaylistFavorite[]

  @@index([userId, createdAt])
  @@index([isPublic, updatedAt])
  @@map("user_playlists")
}

// Favourites for playlists owned by the same user. These do not create a
// second Library resource because the playlist already belongs to its owner.
model UserPlaylistFavorite {
  id         String   @id @default(uuid())
  userId     String   @db.VarChar(128)
  playlistId String   @db.VarChar(128)
  createdAt  DateTime @default(now()) @db.Timestamptz

  playlist UserPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([userId, playlistId])
  @@index([userId, createdAt])
  @@index([playlistId])
  @@map("user_playlist_favorites")
}

model UserPlaylistTrack {
  playlistId String
  songId     String
  sourceAlbumId String? @db.VarChar(128)
  position   Int
  addedAt    DateTime @default(now()) @db.Timestamptz

  playlist UserPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song     Song         @relation(fields: [songId], references: [id], onDelete: Cascade)
  sourceAlbum Album?    @relation("UserPlaylistTrackSourceAlbum", fields: [sourceAlbumId], references: [id], onDelete: SetNull)

  @@id([playlistId, songId])
  @@unique([playlistId, position])
  @@index([songId])
  @@index([sourceAlbumId])
  @@map("user_playlist_tracks")
}

// Public playlist favourites are separate from Library membership. Removing
// the favourite must not remove a playlist the user intentionally saved.
model PlaylistFavorite {
  id         String   @id @default(uuid())
  userId     String   @db.VarChar(128)
  playlistId String   @db.VarChar(128)
  createdAt  DateTime @default(now()) @db.Timestamptz

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([userId, playlistId])
  @@index([userId, createdAt])
  @@index([playlistId])
  @@map("playlist_favorites")
}

// The Favourite Songs playlist is a virtual, per-user collection rather than
// a row in Playlist. Keep its optional "super favourite" state separate so
// public playlist foreign-key integrity remains intact.
model SystemPlaylistFavorite {
  id        String   @id @default(uuid())
  userId    String   @unique @db.VarChar(128)
  createdAt DateTime @default(now()) @db.Timestamptz

  @@map("system_playlist_favorites")
}

model UserLibraryResource {
  id           String    @id @default(uuid())
  userId       String    @db.VarChar(128)
  resourceType String    @db.VarChar(32)
  resourceId   String    @db.VarChar(128)
  sourceAlbumId String?  @db.VarChar(128)
  title        String    @default("") @db.VarChar(255)
  subtitle     String    @default("") @db.VarChar(255)
  artworkUrl   String    @default("") @db.VarChar(1000)
  isPinned     Boolean   @default(false)
  pinnedAt     DateTime? @db.Timestamptz
  createdAt    DateTime  @default(now()) @db.Timestamptz

  sourceAlbum Album? @relation("LibraryResourceSourceAlbum", fields: [sourceAlbumId], references: [id], onDelete: SetNull)

  @@unique([userId, resourceType, resourceId])
  @@index([userId, createdAt])
  @@index([userId, resourceType, createdAt, resourceId])
  @@index([userId, resourceType, title, resourceId])
  @@index([userId, isPinned, pinnedAt])
  @@index([sourceAlbumId])
  @@map("user_library_resources")
}
