# ======== PostgreSQL =============
DATABASE_URL

# ========== Redis ==========
REDIS_HOST
REDIS_PORT
REDIS_PASSWORD

# ========== Pending Cleanup ==========
SONG_PENDING_CLEANUP_ENABLED=true
SONG_PENDING_STALE_MINUTES=180
SONG_PENDING_CLEANUP_INTERVAL_SEC=300
SONG_PENDING_CLEANUP_BATCH_SIZE=200
SONG_COMPLETION_STREAM_CLAIM_IDLE_MS=60000
SONG_COMPLETION_STREAM_MAX_DELIVERIES=5
# Lease duration for the completion state transition. It is renewed while a
# handler runs, and must be positive.
SONG_COMPLETION_LOCK_TTL_MS=60000
SONG_ASSET_CLEANUP_STREAM_CLAIM_IDLE_MS=60000
SONG_ASSET_CLEANUP_STREAM_MAX_DELIVERIES=5
SONG_ASSET_CLEANUP_OUTBOX_MAX_ATTEMPTS=10
SONG_ASSET_CLEANUP_OUTBOX_LOCK_TTL_MS=60000
TRANSCODE_OUTBOX_POLL_INTERVAL_MS=1000
TRANSCODE_OUTBOX_LOCK_TTL_MS=60000
TRANSCODE_OUTBOX_MAX_ATTEMPTS=10
TRANSCODE_QUEUE=transcode_queue
# Redis Stream retention: main queues are trimmed only below every consumer
# group's ACK watermark; DLQs are retained by age for manual investigation.
REDIS_STREAM_MAIN_RETENTION_MS=604800000
REDIS_STREAM_DLQ_RETENTION_MS=2592000000
REDIS_STREAM_RETENTION_INTERVAL_MS=3600000
REDIS_STREAM_TRIM_BATCH_SIZE=1000

# ========== R2 ==========
R2_ENDPOINT
R2_ACCESS_KEY
R2_SECRET_KEY
R2_BUCKET

# ========== GRPC_URL ==========
ASSET_GRPC_URL=localhost:7979

# ========== GRPC_TOKEN ==========
INTERNAL_GRPC_TOKEN
SONG_GRPC_URL=0.0.0.0:7777
 
CATALOG_ASSET_SYNC_POLL_INTERVAL_MS=2000
CATALOG_ASSET_SYNC_LOCK_TTL_MS=60000
