# ========== GRPC_URL ==========
ASSET_GRPC_URL=localhost:7979

# ======= PostgreSQL =========
DATABASE_URL

# ========== R2 ==========
R2_ENDPOINT
R2_ACCESS_KEY
R2_SECRET_KEY
R2_BUCKET

# ========== CDN URL ==========
CDN_URL

# ========== GRPC_TOKEN ==========
INTERNAL_GRPC_TOKEN

# AES-256-GCM wrapping key for per-video AES-128 HLS keys (64 hex chars).
ASSET_VIDEO_KEY_ENCRYPTION_KEY
# Public API base used in HLS EXT-X-KEY, e.g. http://localhost:9999/v1/playback/videos
ASSET_VIDEO_KEY_URI_BASE

# Required Modal endpoint for GPU Music Video HLS transcoding.
VIDEO_TRANSCODE_URL=
VIDEO_TRANSCODE_STATUS_URL=
VIDEO_TRANSCODE_SHARED_SECRET=
VIDEO_TRANSCODE_TIMEOUT_MS=5400000

ASSET_WORKER_ENABLED=true
ASSET_WORKER_POLL_INTERVAL_MS=2000
ASSET_WORKER_LOCK_TTL_MS=1800000
ASSET_VIDEO_WORKER_LOCK_TTL_MS=120000
ASSET_WORKER_MAX_ATTEMPTS=5
ASSET_WORKER_METRICS_INTERVAL_MS=60000
ASSET_ARTIFACT_CLEANUP_ENABLED=true
ASSET_ARTIFACT_CLEANUP_POLL_INTERVAL_MS=300000
ASSET_ARTIFACT_CLEANUP_LOCK_TTL_MS=600000
ASSET_ARTIFACT_CLEANUP_RETRY_MAX_BACKOFF_MS=3600000
ASSET_ARTIFACT_CLEANUP_METRICS_INTERVAL_MS=60000
ASSET_FAILED_ARTIFACT_RETENTION_MS=604800000
ASSET_ARTWORK_MAX_INPUT_PIXELS=30000000
ASSET_IMAGE_RENDITION_CONCURRENCY=2
