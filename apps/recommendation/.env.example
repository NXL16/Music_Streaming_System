# ======== PostgreSQL =========
DATABASE_URL=postgresql://user:password@localhost:5432/music_recommendation_db

# ========== GRPC_URL ==========
RECOMMENDATION_GRPC_URL=0.0.0.0:7878
SONG_GRPC_URL=localhost:7777
INTERNAL_GRPC_TOKEN

# Optional ISO-8601 evaluation baseline. Quality analytics uses the later of
# this timestamp and its rolling window, so historic interaction data cannot
# influence a new production-model evaluation.
RECOMMENDATION_QUALITY_BASELINE_AT

# Cross-pod lazy Home generation lease. Renewal must stay below half the TTL.
RECOMMENDATION_GENERATION_LEASE_TTL_MS=1200000
RECOMMENDATION_GENERATION_LEASE_RENEW_INTERVAL_MS=60000

# Optional derived audio-vector index. Leave QDRANT_URL empty until Qdrant is
# deployed; Home/catalog generation continues without vector retrieval.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_AUDIO_COLLECTION=song_audio_embeddings_v1
