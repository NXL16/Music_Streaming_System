# ======== PostgreSQL =========
DATABASE_URL=postgresql://user:password@localhost:5432/music_user_db

# ========== MongoDB ==========
MONGODB_URI=mongodb://localhost:27017/music_user_db

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD

# ========== JWT ==========
JWT_ACCESS_SECRET
JWT_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_MAX_ACTIVE_SESSIONS=20

# ========== Email (Resend) ==========
RESEND_API_KEY
MAIL_FROM
PASSWORD_RESET_URL
EMAIL_VERIFICATION_URL

# ========== 2FA ==========
TWO_FACTOR_SECRET_KEY=
TWO_FACTOR_TRUST_DAYS_USER=180
TWO_FACTOR_TRUST_DAYS_ADMIN=90

# ========== Maintenance (optional) ==========
TOKEN_CLEANUP_INTERVAL_MINUTES=60
RECOVERY_CODE_RETENTION_DAYS=30

# ========== GRPC_URL ==========
IDENTITY_GRPC_URL=0.0.0.0:8888
WALLET_GRPC_URL=localhost:50051
WALLET_GRPC_TLS_ENABLED=false
WALLET_GRPC_TLS_CA_FILE=
WALLET_GRPC_TLS_CLIENT_CERT_FILE=
WALLET_GRPC_TLS_CLIENT_KEY_FILE=
WALLET_GRPC_TIMEOUT_MS=10000

# ========== GRPC_TOKEN ==========
INTERNAL_GRPC_TOKEN

# ========== Google OAuth ==========
GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET

# ========== Identity provisioning outbox (optional) ==========
IDENTITY_OUTBOX_POLL_INTERVAL_MS=5000
IDENTITY_OUTBOX_BATCH_SIZE=20
IDENTITY_OUTBOX_LEASE_SECONDS=60
IDENTITY_OUTBOX_MAX_ATTEMPTS=12
