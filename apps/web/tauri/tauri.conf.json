{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Music",
  "version": "1.0.0",
  "identifier": "me.404hz.music",
  "build": {
    "beforeDevCommand": "pnpm --dir .. dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "https://music.404hz.me"
  },
  "app": {
    "windows": [
      {
        "title": "Music",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "maximized": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../app/favicon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
