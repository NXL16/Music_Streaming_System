# ======== PostgreSQL =========
DATABASE_URL=postgresql://user:password@localhost:5432/music_wallet_db

# ========== Server ==========
GRPC_PORT=127.0.0.1:50051
HTTP_PORT=:8080

# ========== Security ==========
SECRET_KEY
INTERNAL_GRPC_TOKEN

# Keep TLS disabled only for local development or an explicitly private network.
# Mount PEM files from the secret manager when enabling TLS/mTLS.
WALLET_GRPC_TLS_ENABLED=false
WALLET_GRPC_TLS_CERT_FILE=
WALLET_GRPC_TLS_KEY_FILE=
WALLET_GRPC_TLS_CLIENT_CA_FILE=
# Keep false unless a verified private network/service mesh supplies equivalent
# transport security. Without TLS this service otherwise only permits loopback.
WALLET_GRPC_ALLOW_INSECURE_BIND=false

# ========== MoMo Payment ==========
MOMO_PARTNER_CODE
MOMO_ACCESS_KEY
MOMO_SECRET_KEY
MOMO_API_URL
MOMO_REDIRECT_URL
MOMO_NOTIFY_URL

# ========== NF Bank Payment ==========
# Keep the three credentials in the untracked .env file; do not commit them.
NFBANK_PARTNER_CODE=
NFBANK_ACCESS_KEY=
NFBANK_SECRET_KEY=
# NF Bank API base URL. Used for deposits, account verification, and payouts.
# NFBANK_API_URL remains supported for backward compatibility.
NFBANK_API_BASE_URL=http://localhost:8080/api/v1
# Must be publicly reachable by the browser and NF Bank respectively.
NFBANK_REDIRECT_URL=http://localhost:3000/payments/nfbank/return
NFBANK_NOTIFY_URL=http://localhost:9999/v1/wallet/webhook/nfbank
