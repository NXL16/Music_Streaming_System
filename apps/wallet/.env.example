# ======== PostgreSQL =========
DATABASE_URL=postgresql://user:password@localhost:5432/music_wallet_db

# ========== Server ==========
GRPC_PORT=127.0.0.1:50051
HTTP_PORT=:8080

# ========== Security ==========
SECRET_KEY
INTERNAL_GRPC_TOKEN

# Keep TLS disabled only for local development or an explicitly private network.
# Mount PEM files from the secret manager when enabling TLS/mTLS.
WALLET_GRPC_TLS_ENABLED=false
WALLET_GRPC_TLS_CERT_FILE=
WALLET_GRPC_TLS_KEY_FILE=
WALLET_GRPC_TLS_CLIENT_CA_FILE=
# Keep false unless a verified private network/service mesh supplies equivalent
# transport security. Without TLS this service otherwise only permits loopback.
WALLET_GRPC_ALLOW_INSECURE_BIND=false

# ========== MoMo Payment ==========
MOMO_PARTNER_CODE
MOMO_ACCESS_KEY
MOMO_SECRET_KEY
MOMO_API_URL
MOMO_REDIRECT_URL
MOMO_NOTIFY_URL

# ========== NF Bank Payment ==========
NFBANK_PARTNER_CODE
NFBANK_ACCESS_KEY
NFBANK_SECRET_KEY
NFBANK_API_URL
NFBANK_REDIRECT_URL
NFBANK_NOTIFY_URL
