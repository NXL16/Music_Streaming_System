# ========== API Gateway ==========
API_HOST=localhost
API_PORT=9999
API_PREFIX=v1

# ========== GRPC_URL ==========
IDENTITY_GRPC_URL=localhost:8888
SONG_GRPC_URL=localhost:7777
META_GRPC_URL=localhost:4410
# Keep false only for local development or an explicitly private service mesh.
# For TLS/mTLS, mount PEM files from the secret manager.
META_GRPC_TLS_ENABLED=false
META_GRPC_TLS_CA_FILE=
META_GRPC_TLS_CLIENT_CERT_FILE=
META_GRPC_TLS_CLIENT_KEY_FILE=
WALLET_GRPC_URL=localhost:50051
WALLET_GRPC_TLS_ENABLED=false
WALLET_GRPC_TLS_CA_FILE=
WALLET_GRPC_TLS_CLIENT_CERT_FILE=
WALLET_GRPC_TLS_CLIENT_KEY_FILE=
RECOMMENDATION_GRPC_URL=localhost:7878
ASSET_GRPC_URL=localhost:7979

# ========== HTTP_URL ==========
WALLET_HTTP_URL=http://localhost:8080

# ========== GRPC_TOKEN ==========
INTERNAL_GRPC_TOKEN

# ========== CORS ==========
CORS_ORIGIN=http://localhost:3000

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD

# ========== Request limits ==========
API_RATE_LIMIT_PER_MINUTE=120
API_CATALOG_RATE_LIMIT_PER_MINUTE=240

# ========== JWT ==========
JWT_ACCESS_SECRET
MASTER_SECRET_KEY

# ========== R2 ==========
R2_ENDPOINT
R2_ACCESS_KEY
R2_SECRET_KEY
R2_BUCKET

# ========== Stream ==========
STREAM_WORKER_URL=http://localhost:8787

FINALIZER_INTERNAL_TOKEN
FINALIZE_LOCK_TTL_SEC

# ========== Local test ==========
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_MAX_AGE_DAYS=7

# ========== Room SSO ==========
ROOM_SSO_CALLBACK_URL
ROOM_SSO_CLIENT_SECRET
ROOM_SSO_CODE_TTL_SECONDS=60

# ========== Room Music Integration ==========
ROOM_MEDIA_CLIENT_SECRET
ROOM_MEDIA_TICKET_SECRET
ROOM_MEDIA_PUBLIC_BASE_URL
ROOM_MEDIA_TICKET_TTL_SECONDS=600
