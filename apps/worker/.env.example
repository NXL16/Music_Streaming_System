# ========== R2 ==========
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=
R2_BUCKET=

# ========== Redis ==========
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# ========== gRPC ==========
META_GRPC_URL=http://localhost:4410
# Shared with Meta and API. Use a secret-manager value of at least 32 chars.
INTERNAL_GRPC_TOKEN=
# Set true for TLS/mTLS deployments and use an https:// META_GRPC_URL. PEM
# files must be mounted by the secret manager; the client identity is required
# when Meta is configured with META_GRPC_TLS_CLIENT_CA_FILE.
META_GRPC_TLS_ENABLED=false
META_GRPC_TLS_CA_FILE=
META_GRPC_TLS_CLIENT_CERT_FILE=
META_GRPC_TLS_CLIENT_KEY_FILE=

# ========== Encryption ==========
MASTER_SECRET_KEY=

# ========== Worker Config (optional) ==========
TRANSCODE_QUEUE=transcode_queue
WORKER_MAX_CONCURRENCY=4
WORKER_JOB_MAX_RETRIES=3
WORKER_RETRY_BACKOFF_MS=300
# Must exceed the longest normal end-to-end pipeline duration. The default
# below covers the 15-minute Modal deadline plus packaging and uploads.
WORKER_STREAM_CLAIM_IDLE_MS=2400000
WORKER_STREAM_MAX_DELIVERIES=5
WORKER_MAX_SOURCE_SIZE_BYTES=262144000
WORKER_DOWNLOAD_TIMEOUT_SEC=120
WORKER_TRANSCODE_TIMEOUT_SEC=600

# ========== Worker Core ==========
WORKER_CONCURRENCY=4

# Hybrid upload (single put + multipart)
WORKER_SINGLE_PUT_THRESHOLD_BYTES=5242880
WORKER_UPLOAD_PART_SIZE_BYTES=8388608
WORKER_MULTIPART_MAX_INFLIGHT=3
# Retry policy
WORKER_PUT_OBJECT_MAX_RETRIES=3
WORKER_UPLOAD_PART_MAX_RETRIES=3
WORKER_UPLOAD_PART_BACKOFF_BASE_MS=120

# ========== Stem separation (Modal GPU) ==========
# Modal runs BS-RoFormer and writes M4A stems to staging/{songId}. The Rust
# worker then packages/encrypts both playback assets as fragmented MP4.
# Infrastructure safety switch. Jobs still use Modal only when audio_mode=SING.
# Enable only after the Modal endpoint and `music-r2` secret have been deployed.
STEM_SEPARATION_ENABLED=false
STEM_SEPARATION_URL=
STEM_SEPARATION_SHARED_SECRET=
STEM_SEPARATION_TIMEOUT_SEC=900

# ========== CLAP audio intelligence (Modal GPU) ==========
# Runs on the original mix. Analysis failure never prevents playback readiness.
AUDIO_INTELLIGENCE_ENABLED=false
AUDIO_INTELLIGENCE_URL=
AUDIO_INTELLIGENCE_SHARED_SECRET=
# Dedicated Redis Stream; CLAP must never delay transcode completion.
AUDIO_INTELLIGENCE_QUEUE=audio_intelligence_queue
