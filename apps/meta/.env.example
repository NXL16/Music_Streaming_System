# ========== gRPC ==========
# Prefer an explicit interface. Keep this loopback value for local development;
# use a private interface plus TLS/mTLS for a multi-host deployment.
META_GRPC_LISTEN_ADDR=127.0.0.1:4410
# Backward-compatible fallback only when META_GRPC_LISTEN_ADDR is unset.
META_GRPC_PORT=4410
# Shared with trusted internal callers (API and worker); use a random value of
# at least 32 characters and distribute it via the secret manager.
INTERNAL_GRPC_TOKEN=

# Enable TLS for any deployment that is not protected by an equivalent private
# network policy. Mount PEM files from the secret manager; do not commit them.
# Setting META_GRPC_TLS_CLIENT_CA_FILE enables mTLS and requires a valid client
# certificate from API and Worker on every connection.
META_GRPC_TLS_ENABLED=false
META_GRPC_TLS_CERT_FILE=
META_GRPC_TLS_KEY_FILE=
META_GRPC_TLS_CLIENT_CA_FILE=

# ========== MongoDB ==========
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=music_meta_db
