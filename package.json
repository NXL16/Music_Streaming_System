{
  "name": "01-musical",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "predev": "pnpm --filter @musical/shared-constants build && pnpm proto:gen",
    "dev": "node tools/scripts/dev.mjs development",
    "predev:production": "pnpm --filter @musical/shared-constants build && pnpm proto:gen",
    "dev:production": "node tools/scripts/dev.mjs production",
    "prebuild": "pnpm proto:gen",
    "build": "turbo run build",
    "test": "turbo run test -- --passWithNoTests",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "type-check": "turbo run type-check",
    "clean": "node tools/scripts/clean.mjs",
    "clean:install": "pnpm clean && pnpm install --frozen-lockfile",
    "docker:up": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/scripts/docker-up-redis.ps1",
    "docker:down": "docker rm -f my-redis",
    "docker:logs": "docker logs -f my-redis",
    "proto:gen": "pnpm --dir packages/shared-proto generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@types/node": "^20.19.0",
    "knip": "^6.29.0",
    "tsx": "^4.23.1",
    "turbo": "^2.10.6",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@grpc/grpc-js": "^1.14.4",
    "@nestjs/mapped-types": "*",
    "@nestjs/microservices": "^11.1.28",
    "pg": "^8.22.0",
    "rxjs": "^7.8.2"
  }
}
